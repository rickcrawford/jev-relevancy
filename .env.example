# Copy to .env and fill in. Never commit .env.

# Required: retrieval, embedding, and hosted rerankers.
TURBOPUFFER_API_KEY=

# Optional: Jev through TypeSafe's API (steps 6, 7, 8). https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: LLM judges and rerankers through OpenRouter (steps 6, 7, 8). https://openrouter.ai
OPENROUTER_API_KEY=

# Optional overrides.
# TURBOPUFFER_REGION=aws-us-east-1
# EMBED_MODEL=voyage/voyage-4-lite
# JEV_MODEL=jev-1.13.0
